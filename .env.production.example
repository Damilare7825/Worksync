# Production deployment values. Store the real values in your secret manager,
# CI/CD secret store, or deployment platform; do not commit a populated file.
# Supabase PostgreSQL
# Use the session pooler (port 5432) for DATABASE_URL, or the transaction
# pooler (port 6543) with pgbouncer=true for runtime traffic. Keep DIRECT_URL
# on a direct or session-pooler connection for Prisma migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<supabase-session-pooler-host>:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<supabase-session-pooler-host>:5432/postgres?sslmode=require
# Transaction-pooler runtime alternative for DATABASE_URL only:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<supabase-transaction-pooler-host>:6543/postgres?sslmode=require&pgbouncer=true

# Local Docker only (not for Render or Supabase):
# POSTGRES_DB=worksync
# POSTGRES_USER=worksync
# POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_DATABASE_PASSWORD
# DATABASE_URL=postgresql://worksync:GENERATE_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/worksync?schema=public
JWT_SECRET=GENERATE_A_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=15m
CLIENT_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
MAX_FILE_SIZE=10485760

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=WorkSync <no-reply@example.com>

# Object Storage (S3 / Cloudflare R2) — required in production
STORAGE_PROVIDER=S3
STORAGE_BUCKET=worksync-production-attachments
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Frontend build-time values
# Local reverse-proxy only. For Render, use the absolute API origin; the app
# appends /api/v1 automatically.
# VITE_API_URL=/api/v1
VITE_API_URL=https://worksync-api.onrender.com
VITE_SOCKET_URL=https://app.example.com
