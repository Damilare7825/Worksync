# ---------------------------------------------
# WorkSync Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file.
# ---------------------------------------------

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/worksync?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/worksync?schema=public"

# JWT
# Generate a unique value with a cryptographically secure generator.
JWT_SECRET="CHANGE_ME__GENERATE_A_LONG_RANDOM_SECRET_BEFORE_USE"
JWT_EXPIRES_IN="15m"

# Server
PORT=5000
NODE_ENV=development

# CORS - the URL of the frontend client allowed to call this API
CLIENT_URL="http://localhost:5173"
# Optional comma-separated production allow-list. CLIENT_URL is used when omitted.
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Attachment storage
# For local development: LOCAL storage saves to UPLOAD_DIR.
# For production: STORAGE_PROVIDER must be S3 (AWS S3, Cloudflare R2, or S3-compatible).
STORAGE_PROVIDER="LOCAL"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# S3 / Cloudflare R2 Object Storage (Mandatory in production, optional in development)
# STORAGE_PROVIDER="S3"
# STORAGE_BUCKET="your-bucket-name"
# STORAGE_REGION="auto"
# STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_ACCESS_KEY_ID="your-access-key-id"
# STORAGE_SECRET_ACCESS_KEY="your-secret-access-key"

# Email (SMTP) — required for real email delivery in production.
# If SMTP configuration is missing in production, the application will
# fail explicitly rather than silently falling back to a mock provider.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="apikey"
SMTP_PASS="your-smtp-key"
EMAIL_FROM="WorkSync <no-reply@worksync.com>"
