// WorkSync Prisma schema
// Run `npx prisma migrate dev --name <name>` after editing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectRole {
  MANAGER
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Kept intentionally small and generic (not BLOCKS/BLOCKED_BY as separate
// rows) — a single DEPENDS_ON edge from `task` to `dependsOnTask` is enough
// to derive both directions (this task's dependencies, and what depends on
// it) via the two inverse relations on Task below. New relationship types
// can be added here later without a schema migration touching existing rows.
enum TaskDependencyType {
  DEPENDS_ON
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
}

enum InvitationStatus {
  INVITED
  ACCEPTED
  EXPIRED
  DECLINED
}

enum NotificationType {
  TASK_ASSIGNED
  MENTION
  COMMENT
  INVITATION
  ROLE_CHANGE
  DEADLINE_REMINDER
  PROJECT_UPDATE
  TASK_UPDATE
  REACTION
  DISCUSSION_RESOLVED
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  avatar       String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Password reset flow: a hash of the reset token (never the raw token)
  // plus an expiry. Cleared once used or on password change.
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?

  // Intentionally NOT present: a global `role` field. Authorization is
  // always derived from WorkspaceMember / ProjectMember rows — see
  // src/services/authorization.service.js.
  ownedWorkspaces      Workspace[]       @relation("WorkspaceCreator")
  workspaceMemberships WorkspaceMember[]
  createdTeams         Team[]            @relation("TeamCreator")
  teamMemberships      TeamMember[]
  createdProjects      Project[]         @relation("ProjectCreator")
  projectMemberships   ProjectMember[]
  createdTasks         Task[]            @relation("TaskCreator")
  assignedTasks        Task[]            @relation("TaskAssignee")
  comments             Comment[]
  activityLogs         ActivityLog[]
  notifications        Notification[]
  sentInvitations      Invitation[]      @relation("InvitationInviter")
  watchedTasks         TaskWatcher[]
  commentMentions      CommentMention[]
  commentReactions     CommentReaction[]
  resolvedComments     Comment[]         @relation("CommentResolvedBy")
  attachments          Attachment[]      @relation("AttachmentUploader")
  preferences          UserPreference?
  notificationPreferences NotificationPreference?
  sessions             Session[]

  @@index([email])
  @@index([resetPasswordTokenHash])
  @@map("users")
}

// ---------------------------------------------------------------------------
// User Preferences
// ---------------------------------------------------------------------------

model UserPreference {
  id          String   @id @default(uuid())
  userId      String   @unique
  theme       ThemePreference @default(SYSTEM)
  timezone    String   @default("UTC")
  dateFormat  String   @default("MM/dd/yyyy")
  timeFormat  String   @default("hh:mm a")
  compactDensity Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

// ---------------------------------------------------------------------------
// Notification Preferences
// ---------------------------------------------------------------------------

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  taskAssignments Boolean  @default(true)
  taskUpdates     Boolean  @default(true)
  dueDateReminders Boolean @default(true)
  mentions        Boolean  @default(true)
  comments        Boolean  @default(true)
  replies         Boolean  @default(true)
  reactions       Boolean  @default(true)
  workspaceActivity Boolean @default(true)
  projectActivity Boolean @default(true)
  invitations     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Session — tracks active JWT sessions so logout and password changes can
// revoke tokens server-side.
// ---------------------------------------------------------------------------

model Session {
  id             String   @id @default(uuid())
  userId         String
  refreshTokenHash String? @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshTokenHash])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Job — durable background job queue backed by PostgreSQL.
// ---------------------------------------------------------------------------

model Job {
  id             String   @id @default(uuid())
  type           String
  payload        Json
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  idempotencyKey String?  @unique
  nextAttemptAt  DateTime?
  processedAt    DateTime?
  failedAt       DateTime?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([idempotencyKey])
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// Workspace
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Shareable "anyone with this link can join" invite link — deliberately
  // a separate mechanism from Invitation (which is per-email, one-time,
  // and only ever stores a hash). This one is also stored as a hash (SHA-256)
  // for security, meant to be redisplayed/copied by OWNER/ADMIN; raw value
  // never stored. Revoked by disabling/regenerating, not by "using it up".
  inviteLinkToken   String?       @unique
  inviteLinkEnabled Boolean       @default(false)
  inviteLinkRole    WorkspaceRole @default(MEMBER)

  creator      User              @relation("WorkspaceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  members      WorkspaceMember[]
  teams        Team[]
  projects     Project[]
  invitations  Invitation[]
  activityLogs ActivityLog[]
  labels       Label[]
  attachments  Attachment[]

  @@index([createdBy])
  @@map("workspaces")
}

// ---------------------------------------------------------------------------
// Workspace Member
// ---------------------------------------------------------------------------

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user cannot have two membership rows in the same workspace.
  @@unique([workspaceId, userId])
  @@index([workspaceId, userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Team (organizational grouping inside a Workspace)
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User         @relation("TeamCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  members   TeamMember[]

  @@index([workspaceId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId, userId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// Project (belongs to a Workspace)
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(uuid())
  workspaceId String
  name        String
  description String?
  createdBy   String
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator      User            @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  tasks        Task[]
  activityLogs ActivityLog[]
  attachments  Attachment[]

  @@index([workspaceId])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, userId])
  @@map("project_members")
}

// ---------------------------------------------------------------------------
// Task
// ---------------------------------------------------------------------------

model Task {
  id          String       @id @default(uuid())
  projectId   String
  creatorId   String
  assigneeId  String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  // Board/list ordering within a (project, status) column. Lower numbers
  // appear first. Clients never invent absolute positions blindly — the
  // move/reorder API reindexes the column server-side.
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Subtasks: a simple one-level parent/child tree (a subtask can itself
  // have subtasks — recursion isn't blocked at the schema level — but the
  // service layer prevents a task from becoming its own ancestor). Cascade
  // on delete: removing a parent removes its subtasks, matching how the
  // rest of the app treats a task and its "contents".
  parentTaskId String?
  parent       Task?  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[] @relation("TaskSubtasks")

  // Recurring tasks: a Task can carry a RecurrenceRule (making it the
  // "template"/most-recent occurrence), and a generated occurrence keeps a
  // pointer back to the rule that produced it via generatedFromRuleId.
  // SetNull rather than Cascade for generatedFromRuleId — deleting the
  // rule shouldn't delete tasks it already generated, just stop it from
  // being credited as their source.
  recurrenceRule    RecurrenceRule? @relation("RecurrenceRuleTask")
  generatedFromRuleId String?
  generatedFromRule   RecurrenceRule? @relation("RecurrenceRuleGenerated", fields: [generatedFromRuleId], references: [id], onDelete: SetNull)

  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator      User            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee     User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments     Comment[]
  activityLogs ActivityLog[]
  checklistItems ChecklistItem[]
  watchers       TaskWatcher[]
  labels         TaskLabel[]
  // This task's own dependencies ("depends on" edges where this task is
  // the dependent side) and the inverse (tasks that depend on this one).
  dependencies   TaskDependency[] @relation("TaskDependencies")
  dependents     TaskDependency[] @relation("TaskDependents")
  attachments    Attachment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([completedAt])
  @@index([createdAt])
  @@index([dueDate])
  @@index([priority])
  @@index([projectId, status, dueDate])
  @@index([projectId, status, position])
  @@index([parentTaskId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Task dependencies
// ---------------------------------------------------------------------------

model TaskDependency {
  id            String             @id @default(uuid())
  taskId        String
  dependsOnTaskId String
  type          TaskDependencyType @default(DEPENDS_ON)
  createdAt     DateTime           @default(now())

  task        Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

// ---------------------------------------------------------------------------
// Checklists
// ---------------------------------------------------------------------------

model ChecklistItem {
  id        String   @id @default(uuid())
  taskId    String
  text      String
  completed Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("checklist_items")
}

// ---------------------------------------------------------------------------
// Labels — scoped to a workspace (not per-project) so the same label
// vocabulary is reusable across every project in it, mirroring how
// WorkspaceMember/ProjectMember split workspace-wide vs project-local
// concepts elsewhere in the schema.
// ---------------------------------------------------------------------------

model Label {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String   @default("#6366F1")
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("labels")
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

// ---------------------------------------------------------------------------
// Watchers
// ---------------------------------------------------------------------------

model TaskWatcher {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_watchers")
}

// ---------------------------------------------------------------------------
// Recurring tasks
//
// A RecurrenceRule lives on one "template" Task (recurrenceRule relation
// above) and describes when the next occurrence is due. Generation itself
// (computeNextOccurrence / generateDueOccurrence in recurrence.service.js)
// is plain, schedulable domain logic — it doesn't assume any particular
// job runner. Wiring it to an actual scheduler/cron is left to whichever
// later phase introduces background job infrastructure; this phase only
// guarantees the backend, not the frontend clock, is authoritative for
// *whether* an occurrence is due.
// ---------------------------------------------------------------------------

model RecurrenceRule {
  id         String            @id @default(uuid())
  taskId     String            @unique
  pattern    RecurrencePattern
  interval   Int               @default(1)
  timezone   String            @default("UTC")
  nextRunAt  DateTime
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  task              Task   @relation("RecurrenceRuleTask", fields: [taskId], references: [id], onDelete: Cascade)
  generatedTasks    Task[] @relation("RecurrenceRuleGenerated")

  @@index([active, nextRunAt])
  @@map("recurrence_rules")
}

// ---------------------------------------------------------------------------
// Comment
// ---------------------------------------------------------------------------

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Threads: a root comment (parentCommentId null) can have replies
  // (parentCommentId pointing at the root). Replies can't themselves be
  // replied to — enforced in comment.service.js, not the schema — so this
  // stays a simple two-level root+replies model rather than unlimited
  // recursive nesting, per spec.
  parentCommentId String?
  parent          Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")

  // Resolution only has meaning on a root comment (a "discussion"); a
  // reply's resolved/resolvedById/resolvedAt stay at their defaults and
  // are ignored by the service layer.
  resolved   Boolean   @default(false)
  resolvedById String?
  resolvedAt DateTime?

  task       Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?             @relation("CommentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  mentions   CommentMention[]
  reactions  CommentReaction[]
  attachments Attachment[]

  @@index([taskId])
  @@index([userId])
  @@index([parentCommentId])
  @@index([createdAt])
  @@map("comments")
}

model CommentMention {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

model CommentReaction {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@map("comment_reactions")
}

// ---------------------------------------------------------------------------
// Activity Log
// ---------------------------------------------------------------------------

model ActivityLog {
  id          String   @id @default(uuid())
  workspaceId String
  projectId   String?
  taskId      String?
  userId      String
  action      String

  // Denormalized snapshot of what the entry is about. Kept in addition to
  // the (nullable, SetNull-on-delete) projectId/taskId FKs above so that
  // once a project/task is deleted, its history doesn't just vanish —
  // entityType/entityId/entityLabel let the log entry still say "Task
  // 'Ship v2' was deleted" even though the Task row and the FK are gone.
  entityType  String?
  entityId    String?
  entityLabel String?

  // Distinguishes security/permission-sensitive entries (role changes,
  // ownership transfer, invitations, auth events) from routine
  // user-facing activity, so audit views can filter to just those without
  // a second table/model.
  isAudit Boolean @default(false)

  // Small, non-sensitive context only (e.g. { "taskTitle": "..." }) — never
  // passwords, tokens, or full record dumps.
  metadata  Json?
  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // SetNull (not Cascade): deleting a project/task must not delete the
  // history that documents it happened — see entityType/entityId above,
  // which keep the entry meaningful once the FK is nulled out.
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
  @@index([taskId])
  @@index([workspaceId, action])
  @@index([workspaceId, userId])
  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Notification
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Nullable, safe reference to the invitation this notification is
  // about — lets the frontend open a real accept flow without ever
  // needing (or us ever storing) the raw invitation token. Only set for
  // type === INVITATION; SetNull on delete so an old invitation being
  // cleaned up never orphans a notification lookup.
  invitationId String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([createdAt])
  @@index([userId, read, createdAt])
  @@index([invitationId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Invitation
// ---------------------------------------------------------------------------

model Invitation {
  id          String           @id @default(uuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(MEMBER)
  invitedBy   String
  // Stored as a hash, same principle as password reset tokens.
  tokenHash   String           @unique
  status      InvitationStatus @default(INVITED)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([tokenHash])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
  @@index([expiresAt])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Attachment
// ---------------------------------------------------------------------------

model Attachment {
  id              String   @id @default(uuid())
  workspaceId     String
  projectId       String?
  taskId          String?
  commentId       String?
  uploaderId      String
  originalName    String
  storageKey      String
  mimeType        String
  sizeBytes       Int
  storageProvider String   @default("LOCAL")
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploader  User      @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([projectId])
  @@index([taskId])
  @@index([commentId])
  @@index([uploaderId])
  @@index([createdAt])
  @@map("attachments")
}