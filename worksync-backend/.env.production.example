# WorkSync Backend - Production Environment Configuration Template
# Store real credentials in your secrets manager or deployment platform.
# NEVER commit a populated production .env file to version control.

# Server & Runtime
NODE_ENV=production
PORT=5000
RUN_WORKER=false

# Database (PostgreSQL with SSL enabled in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/worksync?schema=public&sslmode=require

# JWT Authentication
# Must be a cryptographically secure random string (minimum 32 characters)
JWT_SECRET=GENERATE_A_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRES_IN=15m

# Client & CORS
CLIENT_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# File & Attachment Limits
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads

# Durable Object Storage (Mandatory in production: STORAGE_PROVIDER=S3)
STORAGE_PROVIDER=S3
STORAGE_BUCKET=worksync-production-attachments
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# Email Delivery (SMTP is required in production; Mock delivery is disabled)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM=WorkSync <no-reply@example.com>
